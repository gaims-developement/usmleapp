NODE_ENV=development
PORT=5000
CLIENT_URL=http://127.0.0.1:5173
# Comma-separated allowlist of origins allowed to call the API (defaults to CLIENT_URL).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174
# Base URL used when building email verification / password reset links.
APP_URL=http://127.0.0.1:5173

# Frontend API base URL (also loaded by Vite as VITE_API_URL)
VITE_API_URL=http://127.0.0.1:5000/api

# MySQL 8
DATABASE_URL="mysql://root:password@localhost:3306/usmle_app"

# JWT
# Access token secret & lifetime
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN=15m
# Refresh token secret & lifetime (must differ from JWT_SECRET)
JWT_REFRESH_SECRET="replace-with-a-different-long-random-secret"
JWT_REFRESH_EXPIRES_IN=30d

# Email verification & password reset token lifetimes
EMAIL_VERIFICATION_EXPIRES_IN=24h
PASSWORD_RESET_EXPIRES_IN=1h

# Cloudinary
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Development mode: when true, exposes the /devmode demo-account login page.
# Keep false in production.
ENABLE_DEVMODE=false
