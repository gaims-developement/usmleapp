generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum RoleName {
  SUPER_ADMIN
  ADMIN
  REVIEWER
  HOSPITAL
  DOCTOR
  STUDENT
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  CHANGES_REQUESTED
  APPROVED
  REJECTED
  FORWARDED
  AWAITING_DECISION
  ACCEPTED
  WAITLISTED
  SCHEDULED
  COMPLETED
}

enum ReviewRecommendation {
  APPROVE
  REJECT
  REQUEST_CHANGES
  FORWARD
}

enum DocumentVerification {
  PENDING
  VERIFIED
  NEEDS_ATTENTION
}

enum ProgramStatus {
  DRAFT
  ACTIVE
  PAUSED
  CLOSED
}

enum AnnouncementStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum SupportStatus {
  OPEN
  PENDING
  RESOLVED
  CLOSED
}

enum SupportPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum CertificateStatus {
  DRAFT
  PENDING_ISSUE
  ISSUED
  REVOKED
}

enum LogbookStatus {
  DRAFT
  SUBMITTED
  APPROVED
}

enum LorStatus {
  DRAFT
  PENDING_REVIEW
  SIGNED
  DELIVERED
}

enum EvaluationStatus {
  DRAFT
  COMPLETED
}

enum ConversationType {
  DIRECT
  GROUP
}

enum NotificationTone {
  INFO
  SUCCESS
  WARNING
  ERROR
}

enum PartnerRegistrationStatus {
  PENDING
  REVIEWED
  APPROVED
  REJECTED
}

model Role {
  id              String           @id @default(cuid())
  name            RoleName         @unique
  description     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  users           User[]
  rolePermissions RolePermission[]
}

model Permission {
  id              String           @id @default(cuid())
  key             String           @unique
  label           String?
  description     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  rolePermissions RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model User {
  id                      String                  @id @default(cuid())
  email                   String                  @unique
  name                    String
  passwordHash            String?
  roleId                  String?
  role                    Role?                   @relation(fields: [roleId], references: [id], onDelete: SetNull)
  onboarded               Boolean                 @default(false)
  emailVerifiedAt         DateTime?
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt

  studentProfile          StudentProfile?
  hospitalProfile         HospitalProfile?
  doctorProfile           DoctorProfile?
  reviewerProfile         ReviewerProfile?
  studentPreference       StudentPreference?

  refreshTokens           RefreshToken[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]

  authoredAnnouncements   Announcement[]         @relation("AnnouncementAuthor")
  conversationParticipants ConversationParticipant[]
  sentMessages            Message[]               @relation("MessageSender")
  notifications           Notification[]
  supportTickets          SupportTicket[]         @relation("TicketReporter")
  assignedTickets         SupportTicket[]         @relation("TicketAssignee")
  messageTemplates        MessageTemplate[]       @relation("TemplateAuthor")
  auditLogs               AuditLog[]              @relation("Actor")
  partnerRegistrations   PartnerRegistration[]   @relation("RegisteredBy")
  reviewedPartnerRegistrations PartnerRegistration[] @relation("ReviewedPartnerRegistrations")
  payments                Payment[]               @relation("Payer")
  calendarEvents          CalendarEvent[]         @relation("EventCreator")
  createdByPrograms       Program[]               @relation("ProgramCreator")
  createdByAnnouncements  Announcement[]         @relation("AnnouncementCreator")

  @@index([roleId])
  @@index([email])
}

model RefreshToken {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique
  expiresAt   DateTime
  revokedAt   DateTime?
  replacedById String?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model StudentProfile {
  id                   String                   @id @default(cuid())
  userId               String                   @unique
  user                 User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  college              String?
  dateOfBirth          DateTime?
  graduationYear       Int?
  visaStatus           String?
  earliestStart        DateTime?
  durationPreference   Int?
  travelReady          Boolean                  @default(false)
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  interests            StudentInterest[]
  locations            StudentLocationPreference[]
  goals                StudentGoal[]
  applications         Application[]

  @@index([college])
}

model StudentInterest {
  id                String          @id @default(cuid())
  studentProfileId  String
  studentProfile    StudentProfile  @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  value             String

  @@unique([studentProfileId, value])
  @@index([studentProfileId])
}

model StudentLocationPreference {
  id                String          @id @default(cuid())
  studentProfileId  String
  studentProfile    StudentProfile  @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  value             String

  @@unique([studentProfileId, value])
  @@index([studentProfileId])
}

model StudentGoal {
  id                String          @id @default(cuid())
  studentProfileId  String
  studentProfile    StudentProfile  @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  value             String

  @@unique([studentProfileId, value])
  @@index([studentProfileId])
}

model StudentPreference {
  id                    String        @id @default(cuid())
  userId                String        @unique
  user                  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  applicationUpdates    Boolean       @default(true)
  announcements         Boolean       @default(true)
  deadlineReminders     Boolean       @default(true)
  marketing             Boolean       @default(false)
  showProfile           Boolean       @default(true)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
}

model HospitalProfile {
  id                 String                  @id @default(cuid())
  userId             String                  @unique
  user               User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name               String?
  city               String?
  state              String?
  country            String?
  email              String?
  phone              String?
  description        String?                 @db.Text
  coordinatorName    String?
  coordinatorEmail   String?
  coordinatorPhone   String?
  tier               String?
  status             String?
  joinedAt           DateTime                @default(now())
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  accreditation      HospitalAccreditation[]
  programs           Program[]
  doctors            DoctorProfile[]
  calendarEvents     CalendarEvent[]
  partnerRegistrations PartnerRegistration[]

  @@index([name])
  @@index([status])
}

model HospitalAccreditation {
  id           String          @id @default(cuid())
  hospitalId   String
  hospital     HospitalProfile @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  label        String

  @@unique([hospitalId, label])
  @@index([hospitalId])
}

model DoctorProfile {
  id                  String            @id @default(cuid())
  userId              String            @unique
  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  hospitalId          String?
  hospital            HospitalProfile?  @relation(fields: [hospitalId], references: [id], onDelete: SetNull)
  specialty           String?
  email               String?
  phone               String?
  availability        String?
  status              String?
  studentsAssigned    Int               @default(0)
  currentRotations    Int               @default(0)
  joinedAt            DateTime          @default(now())
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  applications        Application[]
  rotations           Rotation[]
  evaluations         Evaluation[]
  logbookEntries      LogbookEntry[]
  letters             LetterOfRecommendation[]
  certificates        Certificate[]

  @@index([hospitalId])
  @@index([status])
}

model ReviewerProfile {
  id                 String            @id @default(cuid())
  userId             String            @unique
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  specialty          String?
  department         String?
  timezone           String?
  joinedAt           DateTime          @default(now())
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  applications       Application[]
  reviews            ApplicationReview[]

  @@index([department])
}

model Program {
  id               String                @id @default(cuid())
  hospitalId       String
  hospital         HospitalProfile       @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  creatorId        String?
  creator          User?                 @relation("ProgramCreator", fields: [creatorId], references: [id], onDelete: SetNull)
  title            String
  department       String?
  specialty        String?
  duration         String?
  fee              Decimal?              @db.Decimal(10, 2)
  seats            Int                  @default(0)
  filledSeats      Int                  @default(0)
  deadline         DateTime?
  startDate        DateTime?
  description      String?               @db.Text
  eligibility      String?               @db.Text
  status           ProgramStatus         @default(DRAFT)
  slug             String?               @unique
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  requirements     ProgramRequirement[]
  slots            ProgramSlot[]
  faculty          ProgramFaculty[]
  applications     Application[]

  @@index([hospitalId])
  @@index([status])
  @@index([title])
}

model ProgramRequirement {
  id         String  @id @default(cuid())
  programId  String
  program    Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  requirement String

  @@unique([programId, requirement])
  @@index([programId])
}

model ProgramSlot {
  id           String    @id @default(cuid())
  programId    String
  program      Program   @relation(fields: [programId], references: [id], onDelete: Cascade)
  startDate    DateTime
  endDate      DateTime?
  label        String?
  isAvailable  Boolean   @default(true)
  createdAt    DateTime  @default(now())

  @@unique([programId, startDate])
  @@index([programId])
}

model ProgramFaculty {
  id         String  @id @default(cuid())
  programId  String
  program    Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  name       String

  @@unique([programId, name])
  @@index([programId])
}

model Application {
  id                 String                  @id @default(cuid())
  studentProfileId   String
  studentProfile     StudentProfile          @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  programId          String
  program            Program                 @relation(fields: [programId], references: [id], onDelete: Restrict)
  reviewerProfileId  String?
  reviewerProfile    ReviewerProfile?        @relation(fields: [reviewerProfileId], references: [id], onDelete: SetNull)
  doctorProfileId    String?
  doctorProfile      DoctorProfile?          @relation(fields: [doctorProfileId], references: [id], onDelete: SetNull)
  status             ApplicationStatus       @default(DRAFT)
  submittedAt        DateTime?
  reviewedAt         DateTime?
  reviewMinutes      Int?
  decisionNote       String?                 @db.Text
  internalNotes      String?                 @db.Text
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  languages          ApplicationLanguage[]
  documents          ApplicationDocument[]
  reviews            ApplicationReview[]
  rotation           Rotation?
  evaluations        Evaluation[]
  logbookEntries     LogbookEntry[]
  letters            LetterOfRecommendation[]
  certificates       Certificate[]
  conversations      Conversation[]
  notifications      Notification[]
  payments           Payment[]

  @@index([studentProfileId])
  @@index([programId])
  @@index([reviewerProfileId])
  @@index([doctorProfileId])
  @@index([status])
}

model ApplicationLanguage {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  language      String

  @@unique([applicationId, language])
  @@index([applicationId])
}

model ApplicationDocument {
  id                String                @id @default(cuid())
  applicationId     String
  application       Application           @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  name              String
  documentUrl       String?
  verification      DocumentVerification  @default(PENDING)
  note              String?               @db.Text
  required          Boolean               @default(true)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@unique([applicationId, name])
  @@index([applicationId])
  @@index([verification])
}

model ApplicationReview {
  id                 String              @id @default(cuid())
  applicationId      String
  application        Application         @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  reviewerProfileId  String
  reviewerProfile    ReviewerProfile     @relation(fields: [reviewerProfileId], references: [id], onDelete: Restrict)
  recommendation     ReviewRecommendation?
  reviewerNotes      String?             @db.Text
  internalNotes      String?             @db.Text
  eligibilityJson    Json?
  reviewedAt         DateTime            @default(now())
  reviewMinutes      Int?

  @@index([applicationId, reviewedAt])
  @@index([reviewerProfileId])
}

model Rotation {
  id              String          @id @default(cuid())
  applicationId   String          @unique
  application     Application     @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  doctorProfileId String?
  doctorProfile   DoctorProfile?  @relation(fields: [doctorProfileId], references: [id], onDelete: SetNull)
  startDate       DateTime?
  endDate         DateTime?
  status          String?
  notes           String?         @db.Text
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([doctorProfileId])
}

model Evaluation {
  id                   String             @id @default(cuid())
  applicationId        String
  application          Application        @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  doctorProfileId      String
  doctorProfile        DoctorProfile     @relation(fields: [doctorProfileId], references: [id], onDelete: Restrict)
  status               EvaluationStatus   @default(DRAFT)
  overallPerformance   Int?
  strengths            String?            @db.Text
  areasForImprovement  String?            @db.Text
  overallComments      String?            @db.Text
  finalRecommendation  String?
  submittedAt          DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  scores               EvaluationScore[]

  @@index([applicationId])
  @@index([doctorProfileId])
}

model EvaluationScore {
  id             String      @id @default(cuid())
  evaluationId   String
  evaluation     Evaluation  @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  criterion      String
  score          Int

  @@unique([evaluationId, criterion])
  @@index([evaluationId])
}

model LogbookEntry {
  id              String          @id @default(cuid())
  applicationId   String
  application     Application     @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  doctorProfileId String
  doctorProfile   DoctorProfile   @relation(fields: [doctorProfileId], references: [id], onDelete: Restrict)
  entryDate       DateTime?
  status          LogbookStatus   @default(DRAFT)
  comments        String?         @db.Text
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([applicationId])
  @@index([doctorProfileId])
}

model LetterOfRecommendation {
  id              String          @id @default(cuid())
  applicationId   String
  application     Application     @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  doctorProfileId String
  doctorProfile   DoctorProfile   @relation(fields: [doctorProfileId], references: [id], onDelete: Restrict)
  status          LorStatus       @default(DRAFT)
  summary         String?         @db.Text
  strengths       String?         @db.Text
  body            String?         @db.Text
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([applicationId])
  @@index([doctorProfileId])
}

model Certificate {
  id                 String            @id @default(cuid())
  applicationId      String
  application        Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  doctorProfileId    String
  doctorProfile      DoctorProfile     @relation(fields: [doctorProfileId], references: [id], onDelete: Restrict)
  certificateStatus  CertificateStatus @default(DRAFT)
  issuedAt           DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([applicationId])
  @@index([doctorProfileId])
}

model Announcement {
  id            String               @id @default(cuid())
  authorId      String
  author        User                 @relation("AnnouncementAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  creatorId     String?
  creator       User?                @relation("AnnouncementCreator", fields: [creatorId], references: [id], onDelete: SetNull)
  title         String
  body          String               @db.Text
  status        AnnouncementStatus   @default(DRAFT)
  publishedAt   DateTime?
  views         Int                  @default(0)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  audiences     AnnouncementAudience[]

  @@index([status])
  @@index([publishedAt])
}

model AnnouncementAudience {
  id              String       @id @default(cuid())
  announcementId  String
  announcement    Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  roleName        RoleName

  @@unique([announcementId, roleName])
  @@index([roleName])
}

model Conversation {
  id                String                  @id @default(cuid())
  applicationId     String?
  application       Application?            @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  conversationType  ConversationType        @default(DIRECT)
  title             String?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  participants      ConversationParticipant[]
  messages          Message[]

  @@index([applicationId])
}

model ConversationParticipant {
  id              String        @id @default(cuid())
  conversationId  String
  conversation    Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  unreadCount     Int           @default(0)
  joinedAt        DateTime      @default(now())

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id              String        @id @default(cuid())
  conversationId  String
  conversation    Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId        String
  sender          User          @relation("MessageSender", fields: [senderId], references: [id], onDelete: Restrict)
  body            String        @db.Text
  attachmentName  String?
  attachmentSize  String?
  createdAt       DateTime      @default(now())

  @@index([conversationId, createdAt])
  @@index([senderId])
}

model Notification {
  id            String            @id @default(cuid())
  userId        String
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  applicationId String?
  application   Application?      @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  tone          NotificationTone  @default(INFO)
  title         String
  body          String            @db.Text
  read          Boolean           @default(false)
  createdAt     DateTime          @default(now())

  @@index([userId, read])
  @@index([applicationId])
}

model SupportTicket {
  id            String          @id @default(cuid())
  userId        String
  reporter      User            @relation("TicketReporter", fields: [userId], references: [id], onDelete: Restrict)
  assignedToId  String?
  assignee      User?           @relation("TicketAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  subject       String
  body          String          @db.Text
  role          RoleName?
  priority      SupportPriority @default(MEDIUM)
  status        SupportStatus   @default(OPEN)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  closedAt      DateTime?

  @@index([status, priority])
  @@index([userId])
}

model MessageTemplate {
  id            String    @id @default(cuid())
  createdById   String?
  createdBy     User?     @relation("TemplateAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  label         String
  text          String    @db.Text
  category      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([createdById, label])
  @@index([category])
}

model CmsPage {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  content     String   @db.Text
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published])
}

model ReportDefinition {
  id          String   @id @default(cuid())
  key         String   @unique
  title       String
  description String?  @db.Text
  createdAt   DateTime @default(now())
}

model PlatformSetting {
  id              String   @id @default(cuid())
  siteName        String   @default("USMLEApp")
  supportEmail    String?
  maintenanceMode Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Payment {
  id            String        @id @default(cuid())
  applicationId String
  application   Application   @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  payerId       String
  payer         User          @relation("Payer", fields: [payerId], references: [id], onDelete: Restrict)
  amount        Decimal       @db.Decimal(10, 2)
  currency      String        @default("USD")
  status        PaymentStatus @default(PENDING)
  reference     String?       @unique
  paidAt        DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([applicationId])
  @@index([payerId, status])
}

model CalendarEvent {
  id            String           @id @default(cuid())
  hospitalId    String?
  hospital      HospitalProfile? @relation(fields: [hospitalId], references: [id], onDelete: SetNull)
  createdById   String?
  createdBy     User?            @relation("EventCreator", fields: [createdById], references: [id], onDelete: SetNull)
  title         String
  description   String?          @db.Text
  startAt       DateTime
  endAt         DateTime
  location      String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([hospitalId, startAt])
  @@index([createdById])
}

model PartnerRegistration {
  id                String                    @id @default(cuid())
  registeredById    String?
  registeredBy      User?                     @relation("RegisteredBy", fields: [registeredById], references: [id], onDelete: SetNull)
  hospitalProfileId String?
  hospitalProfile   HospitalProfile?          @relation(fields: [hospitalProfileId], references: [id], onDelete: SetNull)
  organizationName  String
  contactName       String
  contactEmail      String
  phone             String?
  city              String?
  state             String?
  country           String?
  message           String?                   @db.Text
  status            PartnerRegistrationStatus @default(PENDING)
  submittedAt       DateTime                  @default(now())
  reviewedAt        DateTime?
  reviewedById      String?
  reviewedBy        User?                     @relation("ReviewedPartnerRegistrations", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([contactEmail])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorId     String?
  actor       User?    @relation("Actor", fields: [actorId], references: [id], onDelete: SetNull)
  action      String
  entityType  String
  entityId    String
  details     Json?
  ipAddress   String?
  createdAt   DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
}
