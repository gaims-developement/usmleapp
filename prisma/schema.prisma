generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum RoleName {
  SUPER_ADMIN
  ADMIN
  REVIEWER
  HOSPITAL
  DOCTOR
  STUDENT
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  CHANGES_REQUESTED
  APPROVED
  REJECTED
  FORWARDED
  AWAITING_DECISION
  ACCEPTED
  WAITLISTED
  SCHEDULED
  COMPLETED
}

enum ReviewRecommendation {
  APPROVE
  REJECT
  REQUEST_CHANGES
  FORWARD
}

enum DocumentVerification {
  PENDING
  VERIFIED
  NEEDS_ATTENTION
  REQUIRES_UPDATE
  REJECTED
}

enum ProgramStatus {
  DRAFT
  ACTIVE
  PAUSED
  CLOSED
}

enum AnnouncementStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum SupportStatus {
  OPEN
  PENDING
  RESOLVED
  CLOSED
}

enum SupportPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum PaymentStatus {
  AWAITING_PAYMENT
  PAYMENT_SUBMITTED
  UNDER_VERIFICATION
  PAID
  REJECTED
  REFUNDED
}

enum PaymentMethod {
  UPI
  BANK_TRANSFER
  PAYPAL
  RAZORPAY
  STRIPE
}

enum CertificateStatus {
  DRAFT
  PENDING_ISSUE
  ISSUED
  REVOKED
}

enum LogbookStatus {
  DRAFT
  SUBMITTED
  APPROVED
}

enum LorStatus {
  DRAFT
  PENDING_REVIEW
  SIGNED
  DELIVERED
}

enum EvaluationStatus {
  DRAFT
  COMPLETED
}

enum ConversationType {
  DIRECT
  GROUP
}

enum NotificationTone {
  INFO
  SUCCESS
  WARNING
  ERROR
}

enum PartnerRegistrationStatus {
  PENDING
  REVIEWED
  APPROVED
  REJECTED
  INFO_REQUESTED
}

enum ForumPostType {
  DISCUSSION
  QUESTION
  EXPERIENCE
  RESOURCE
  CLINICAL_CASE
  HOSPITAL_REVIEW
}

enum ForumPostStatus {
  PUBLISHED
  HIDDEN
  DELETED
}

enum ForumReportReason {
  SPAM
  HARASSMENT
  MEDICAL_MISINFORMATION
  OFFENSIVE_CONTENT
  ADVERTISING
  PERSONAL_INFORMATION
  OTHER
}

enum ForumReportStatus {
  PENDING
  RESOLVED
  DISMISSED
}

model Role {
  id              String           @id @default(cuid())
  name            RoleName         @unique
  description     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  users           User[]
  rolePermissions RolePermission[]
}

model Permission {
  id              String           @id @default(cuid())
  key             String           @unique
  label           String?
  description     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  rolePermissions RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  name            String
  passwordHash    String?
  avatarUrl       String?
  avatarPublicId  String?
  roleId          String?
  role            Role?     @relation(fields: [roleId], references: [id], onDelete: SetNull)
  onboarded       Boolean   @default(false)
  emailVerifiedAt DateTime?
  deletedAt       DateTime?
  isDemo          Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  studentProfile    StudentProfile?
  hospitalProfile   HospitalProfile?
  doctorProfile     DoctorProfile?
  reviewerProfile   ReviewerProfile?
  studentPreference StudentPreference?

  refreshTokens           RefreshToken[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]

  authoredAnnouncements        Announcement[]            @relation("AnnouncementAuthor")
  conversationParticipants     ConversationParticipant[]
  sentMessages                 Message[]                 @relation("MessageSender")
  notifications                Notification[]
  supportTickets               SupportTicket[]           @relation("TicketReporter")
  assignedTickets              SupportTicket[]           @relation("TicketAssignee")
  messageTemplates             MessageTemplate[]         @relation("TemplateAuthor")
  auditLogs                    AuditLog[]                @relation("Actor")
  partnerRegistrations         PartnerRegistration[]     @relation("RegisteredBy")
  reviewedPartnerRegistrations PartnerRegistration[]     @relation("ReviewedPartnerRegistrations")
  studentPayments              Payment[]                 @relation("StudentPayments")
  verifiedPayments             Payment[]                 @relation("VerifiedPayments")
  calendarEvents               CalendarEvent[]           @relation("EventCreator")
  createdByPrograms            Program[]                 @relation("ProgramCreator")
  createdByAnnouncements       Announcement[]            @relation("AnnouncementCreator")
  createdInvitationCodes       ReviewerInvitationCode[]
  forumPosts                   ForumPost[]
  forumComments                ForumComment[]
  forumReactions               ForumReaction[]
  forumBookmarks               ForumBookmark[]
  forumReportsReported         ForumReport[]              @relation("ReportReporter")
  forumReportsResolved         ForumReport[]              @relation("ReportResolver")
  forumUserModeration          ForumUserModeration?
  forumModerationAudits        ForumModerationAudit[]     @relation("ModeratedUser")
  forumModerationActions       ForumModerationAudit[]     @relation("ModeratorActor")
  forumModerationAppeals       ForumModerationAppeal[]    @relation("AppealUser")
  forumAppealsReviewed         ForumModerationAppeal[]    @relation("AppealReviewer")

  @@index([roleId])
  @@index([email])
}

model RefreshToken {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash    String    @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model StudentProfile {
  id                 String    @id @default(cuid())
  userId             String    @unique
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  college            String?
  dateOfBirth        DateTime?
  graduationYear     Int?
  visaStatus         String?
  earliestStart      DateTime?
  durationPreference Int?
  travelReady        Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  interests    StudentInterest[]
  locations    StudentLocationPreference[]
  goals        StudentGoal[]
  applications Application[]
  documents    StudentDocument[]

  @@index([college])
}

model StudentInterest {
  id               String         @id @default(cuid())
  studentProfileId String
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  value            String

  @@unique([studentProfileId, value])
  @@index([studentProfileId])
}

model StudentLocationPreference {
  id               String         @id @default(cuid())
  studentProfileId String
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  value            String

  @@unique([studentProfileId, value])
  @@index([studentProfileId])
}

model StudentGoal {
  id               String         @id @default(cuid())
  studentProfileId String
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  value            String

  @@unique([studentProfileId, value])
  @@index([studentProfileId])
}

model StudentDocument {
  id               String         @id @default(cuid())
  studentProfileId String
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  name             String
  category         String
  required         Boolean        @default(true)
  status           String         @default("missing") // missing, uploaded, expiring
  fileName         String?
  mimeType         String?
  fileSize         Int?
  storageProvider  String?
  storagePath      String?
  uploadedAt       DateTime?
  expiresAt        DateTime?
  note             String?
  rejectedAt       DateTime?
  rejectedById     String?
  version          Int            @default(1)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  notifications    Notification[]

  @@unique([studentProfileId, name])
  @@index([studentProfileId])
}

model StudentPreference {
  id                 String   @id @default(cuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  applicationUpdates Boolean  @default(true)
  announcements      Boolean  @default(true)
  deadlineReminders  Boolean  @default(true)
  marketing          Boolean  @default(false)
  showProfile        Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model HospitalProfile {
  id               String   @id @default(cuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name             String?
  city             String?
  state            String?
  country          String?
  address          String?
  website          String?
  email            String?
  phone            String?
  description      String?  @db.Text
  coordinatorName  String?
  coordinatorEmail String?
  coordinatorPhone String?
  tier             String?
  status           String?
  joinedAt         DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  accreditation        HospitalAccreditation[]
  hospitalCodes        HospitalRegistrationCode[]
  departments          Department[]
  programs             Program[]
  doctors              DoctorProfile[]
  reviewers            ReviewerProfile[]
  calendarEvents       CalendarEvent[]
  partnerRegistrations PartnerRegistration[]

  @@index([name])
  @@index([status])
}

model Department {
  id         String          @id @default(cuid())
  hospitalId String
  hospital   HospitalProfile @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  name       String
  createdAt  DateTime        @default(now())

  doctors DoctorProfile[]

  @@unique([hospitalId, name])
  @@index([hospitalId])
}

model HospitalRegistrationCode {
  id         String          @id @default(cuid())
  hospitalId String
  hospital   HospitalProfile @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  code       String          @unique
  isActive   Boolean         @default(true)
  usedCount  Int             @default(0)
  expiresAt  DateTime?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([hospitalId])
  @@index([isActive])
}

model HospitalAccreditation {
  id         String          @id @default(cuid())
  hospitalId String
  hospital   HospitalProfile @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  label      String

  @@unique([hospitalId, label])
  @@index([hospitalId])
}

model DoctorProfile {
  id               String           @id @default(cuid())
  userId           String           @unique
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  hospitalId       String?
  hospital         HospitalProfile? @relation(fields: [hospitalId], references: [id], onDelete: SetNull)
  departmentId     String?
  department       Department?      @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  specialty        String?
  title            String?
  licenseNumber    String?
  email            String?
  phone            String?
  availability     String?
  status           String?
  studentsAssigned Int              @default(0)
  currentRotations Int              @default(0)
  joinedAt         DateTime         @default(now())
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  applications   Application[]
  rotations      Rotation[]
  evaluations    Evaluation[]
  logbookEntries LogbookEntry[]
  letters        LetterOfRecommendation[]
  certificates   Certificate[]

  @@index([hospitalId])
  @@index([departmentId])
  @@index([status])
}

model ReviewerProfile {
  id                String           @id @default(cuid())
  userId            String           @unique
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  hospitalId        String?
  hospital          HospitalProfile? @relation(fields: [hospitalId], references: [id], onDelete: SetNull)
  specialty         String?
  department        String?
  timezone          String?
  title             String?
  institution       String?
  phone             String?
  yearsOfExperience Int?
  status            String?
  joinedAt          DateTime         @default(now())
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  applications Application[]
  reviews      ApplicationReview[]

  @@index([hospitalId])
  @@index([department])
  @@index([status])
}

model ReviewerInvitationCode {
  id          String    @id @default(cuid())
  code        String    @unique
  isActive    Boolean   @default(true)
  usedCount   Int       @default(0)
  expiresAt   DateTime?
  createdById String?
  createdBy   User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([isActive])
  @@index([createdById])
}

model Program {
  id          String          @id @default(cuid())
  hospitalId  String
  hospital    HospitalProfile @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  creatorId   String?
  creator     User?           @relation("ProgramCreator", fields: [creatorId], references: [id], onDelete: SetNull)
  title       String
  department  String?
  specialty   String?
  duration    String?
  fee         Decimal?        @db.Decimal(10, 2)
  seats       Int             @default(0)
  filledSeats Int             @default(0)
  deadline    DateTime?
  startDate   DateTime?
  description String?         @db.Text
  eligibility String?         @db.Text
  status      ProgramStatus   @default(DRAFT)
  slug        String?         @unique
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  requirements ProgramRequirement[]
  slots        ProgramSlot[]
  faculty      ProgramFaculty[]
  applications Application[]

  @@index([hospitalId])
  @@index([status])
  @@index([title])
}

model ProgramRequirement {
  id          String  @id @default(cuid())
  programId   String
  program     Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  requirement String

  @@unique([programId, requirement])
  @@index([programId])
}

model ProgramSlot {
  id          String    @id @default(cuid())
  programId   String
  program     Program   @relation(fields: [programId], references: [id], onDelete: Cascade)
  startDate   DateTime
  endDate     DateTime?
  label       String?
  isAvailable Boolean   @default(true)
  createdAt   DateTime  @default(now())

  @@unique([programId, startDate])
  @@index([programId])
}

model ProgramFaculty {
  id        String  @id @default(cuid())
  programId String
  program   Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  name      String

  @@unique([programId, name])
  @@index([programId])
}

model Application {
  id                String            @id @default(cuid())
  studentProfileId  String
  studentProfile    StudentProfile    @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  programId         String
  program           Program           @relation(fields: [programId], references: [id], onDelete: Restrict)
  reviewerProfileId String?
  reviewerProfile   ReviewerProfile?  @relation(fields: [reviewerProfileId], references: [id], onDelete: SetNull)
  doctorProfileId   String?
  doctorProfile     DoctorProfile?    @relation(fields: [doctorProfileId], references: [id], onDelete: SetNull)
  status            ApplicationStatus @default(DRAFT)
  startDate         DateTime?
  durationWeeks     Int?
  submittedAt       DateTime?
  reviewedAt        DateTime?
  reviewMinutes     Int?
  decisionNote      String?           @db.Text
  internalNotes     String?           @db.Text
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  languages      ApplicationLanguage[]
  documents      ApplicationDocument[]
  reviews        ApplicationReview[]
  rotation       Rotation?
  evaluations    Evaluation[]
  logbookEntries LogbookEntry[]
  letters        LetterOfRecommendation[]
  certificates   Certificate[]
  conversations  Conversation[]
  notifications  Notification[]
  payments       Payment[]

  @@index([studentProfileId])
  @@index([programId])
  @@index([reviewerProfileId])
  @@index([doctorProfileId])
  @@index([status])
}

model ApplicationLanguage {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  language      String

  @@unique([applicationId, language])
  @@index([applicationId])
}

model ApplicationDocument {
  id            String               @id @default(cuid())
  applicationId String
  application   Application          @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  name          String
  documentUrl   String?
  verification  DocumentVerification @default(PENDING)
  note          String?              @db.Text
  required      Boolean              @default(true)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@unique([applicationId, name])
  @@index([applicationId])
  @@index([verification])
}

model ApplicationReview {
  id                String                @id @default(cuid())
  applicationId     String
  application       Application           @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  reviewerProfileId String
  reviewerProfile   ReviewerProfile       @relation(fields: [reviewerProfileId], references: [id], onDelete: Restrict)
  recommendation    ReviewRecommendation?
  reviewerNotes     String?               @db.Text
  internalNotes     String?               @db.Text
  eligibilityJson   Json?
  reviewedAt        DateTime              @default(now())
  reviewMinutes     Int?

  @@index([applicationId, reviewedAt])
  @@index([reviewerProfileId])
}

model Rotation {
  id              String         @id @default(cuid())
  applicationId   String         @unique
  application     Application    @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  doctorProfileId String?
  doctorProfile   DoctorProfile? @relation(fields: [doctorProfileId], references: [id], onDelete: SetNull)
  startDate       DateTime?
  endDate         DateTime?
  status          String?
  notes           String?        @db.Text
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([doctorProfileId])
}

model Evaluation {
  id                  String           @id @default(cuid())
  applicationId       String
  application         Application      @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  doctorProfileId     String
  doctorProfile       DoctorProfile    @relation(fields: [doctorProfileId], references: [id], onDelete: Restrict)
  status              EvaluationStatus @default(DRAFT)
  overallPerformance  Int?
  strengths           String?          @db.Text
  areasForImprovement String?          @db.Text
  overallComments     String?          @db.Text
  finalRecommendation String?
  submittedAt         DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  scores EvaluationScore[]

  @@index([applicationId])
  @@index([doctorProfileId])
}

model EvaluationScore {
  id           String     @id @default(cuid())
  evaluationId String
  evaluation   Evaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  criterion    String
  score        Int

  @@unique([evaluationId, criterion])
  @@index([evaluationId])
}

model LogbookEntry {
  id              String        @id @default(cuid())
  applicationId   String
  application     Application   @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  doctorProfileId String
  doctorProfile   DoctorProfile @relation(fields: [doctorProfileId], references: [id], onDelete: Restrict)
  entryDate       DateTime?
  type            String?
  description     String?       @db.Text
  status          LogbookStatus @default(DRAFT)
  comments        String?       @db.Text
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([applicationId])
  @@index([doctorProfileId])
}

model LetterOfRecommendation {
  id              String        @id @default(cuid())
  applicationId   String
  application     Application   @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  doctorProfileId String
  doctorProfile   DoctorProfile @relation(fields: [doctorProfileId], references: [id], onDelete: Restrict)
  status          LorStatus     @default(DRAFT)
  summary         String?       @db.Text
  strengths       String?       @db.Text
  body            String?       @db.Text
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([applicationId])
  @@index([doctorProfileId])
}

model Certificate {
  id                String            @id @default(cuid())
  applicationId     String
  application       Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  doctorProfileId   String
  doctorProfile     DoctorProfile     @relation(fields: [doctorProfileId], references: [id], onDelete: Restrict)
  certificateStatus CertificateStatus @default(DRAFT)
  issuedAt          DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([applicationId])
  @@index([doctorProfileId])
}

model Announcement {
  id          String             @id @default(cuid())
  authorId    String
  author      User               @relation("AnnouncementAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  creatorId   String?
  creator     User?              @relation("AnnouncementCreator", fields: [creatorId], references: [id], onDelete: SetNull)
  title       String
  body        String             @db.Text
  status      AnnouncementStatus @default(DRAFT)
  publishedAt DateTime?
  views       Int                @default(0)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  audiences AnnouncementAudience[]

  @@index([status])
  @@index([publishedAt])
}

model AnnouncementAudience {
  id             String       @id @default(cuid())
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  roleName       RoleName

  @@unique([announcementId, roleName])
  @@index([roleName])
}

model Conversation {
  id               String           @id @default(cuid())
  applicationId    String?
  application      Application?     @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  conversationType ConversationType @default(DIRECT)
  title            String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  participants ConversationParticipant[]
  messages     Message[]

  @@index([applicationId])
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  unreadCount    Int          @default(0)
  joinedAt       DateTime     @default(now())

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Restrict)
  body           String       @db.Text
  attachmentName String?
  attachmentSize String?
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
  @@index([senderId])
}

model Notification {
  id            String           @id @default(cuid())
  userId        String
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  applicationId String?
  application   Application?     @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  documentId    String?
  document      StudentDocument? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  tone          NotificationTone @default(INFO)
  title         String
  body          String           @db.Text
  details       Json?
  read          Boolean          @default(false)
  createdAt     DateTime         @default(now())

  @@index([userId, read])
  @@index([applicationId])
  @@index([documentId])
}

model SupportTicket {
  id           String          @id @default(cuid())
  userId       String
  reporter     User            @relation("TicketReporter", fields: [userId], references: [id], onDelete: Restrict)
  assignedToId String?
  assignee     User?           @relation("TicketAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  subject      String
  body         String          @db.Text
  role         RoleName?
  priority     SupportPriority @default(MEDIUM)
  status       SupportStatus   @default(OPEN)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  closedAt     DateTime?

  @@index([status, priority])
  @@index([userId])
}

model MessageTemplate {
  id          String   @id @default(cuid())
  createdById String?
  createdBy   User?    @relation("TemplateAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  label       String
  text        String   @db.Text
  category    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([createdById, label])
  @@index([category])
}

model CmsPage {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  content   String   @db.Text
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published])
}

model ReportDefinition {
  id          String   @id @default(cuid())
  key         String   @unique
  title       String
  description String?  @db.Text
  createdAt   DateTime @default(now())
}

model PlatformSetting {
  id              String   @id @default(cuid())
  siteName        String   @default("USMLEApp")
  supportEmail    String?
  maintenanceMode Boolean  @default(false)
  enableDemoData  Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Payment {
  id                String        @id @default(cuid())
  applicationId     String
  application       Application   @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  studentId         String
  student           User          @relation("StudentPayments", fields: [studentId], references: [id], onDelete: Restrict)
  amount            Decimal       @db.Decimal(10, 2)
  amountPaid        Decimal?      @db.Decimal(10, 2)
  currency          String        @default("USD")
  paymentMethod     PaymentMethod
  transactionId     String?
  proofImage        String?
  remarks           String?
  status            PaymentStatus @default(AWAITING_PAYMENT)
  gateway           String?       @default("MANUAL")
  paymentDeadline   DateTime?
  submittedAt       DateTime?
  verifiedById      String?
  verifiedBy        User?         @relation("VerifiedPayments", fields: [verifiedById], references: [id], onDelete: SetNull)
  verifiedAt        DateTime?
  verificationNotes String?
  rejectionReason   String?
  internalNotes     String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([applicationId])
  @@index([studentId, status])
  @@index([transactionId])
  @@index([verifiedById])
  @@index([status])
  @@index([submittedAt])
  @@index([createdAt])
}

model CalendarEvent {
  id          String           @id @default(cuid())
  hospitalId  String?
  hospital    HospitalProfile? @relation(fields: [hospitalId], references: [id], onDelete: SetNull)
  createdById String?
  createdBy   User?            @relation("EventCreator", fields: [createdById], references: [id], onDelete: SetNull)
  title       String
  description String?          @db.Text
  startAt     DateTime
  endAt       DateTime
  location    String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([hospitalId, startAt])
  @@index([createdById])
}

model PartnerRegistration {
  id                String                    @id @default(cuid())
  registeredById    String?
  registeredBy      User?                     @relation("RegisteredBy", fields: [registeredById], references: [id], onDelete: SetNull)
  hospitalProfileId String?
  hospitalProfile   HospitalProfile?          @relation(fields: [hospitalProfileId], references: [id], onDelete: SetNull)
  organizationName  String
  contactName       String
  contactEmail      String
  phone             String?
  city              String?
  state             String?
  country           String?
  message           String?                   @db.Text
  reviewMessage     String?                   @db.Text
  status            PartnerRegistrationStatus @default(PENDING)
  submittedAt       DateTime                  @default(now())
  reviewedAt        DateTime?
  reviewedById      String?
  reviewedBy        User?                     @relation("ReviewedPartnerRegistrations", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([contactEmail])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation("Actor", fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String
  details    Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
}

model ForumCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  posts ForumPost[]

  @@index([isActive])
  @@index([sortOrder])
}

model ForumPost {
  id           String           @id @default(cuid())
  authorId     String
  author       User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  categoryId   String
  category     ForumCategory    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  title        String           @db.VarChar(200)
  content      String           @db.Text
  postType     ForumPostType    @default(DISCUSSION)
  status       ForumPostStatus  @default(PUBLISHED)
  upvoteCount  Int              @default(0)
  commentCount Int              @default(0)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  attachments ForumPostAttachment[]
  comments    ForumComment[]
  reactions   ForumReaction[]
  bookmarks   ForumBookmark[]
  reports     ForumReport[]

  @@index([authorId])
  @@index([categoryId])
  @@index([createdAt])
  @@index([status])
  @@index([postType])
}

model ForumPostAttachment {
  id              String   @id @default(cuid())
  postId          String
  post            ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  storageProvider String
  url             String   @db.Text
  publicId        String?
  fileName        String
  mimeType        String
  fileSize        Int
  createdAt       DateTime @default(now())

  @@index([postId])
}

model ForumComment {
  id          String        @id @default(cuid())
  postId      String
  post        ForumPost     @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId    String
  author      User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parentId    String?
  parent      ForumComment? @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies     ForumComment[] @relation("CommentReplies")
  content     String        @db.Text
  status      String        @default("PUBLISHED")
  upvoteCount Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  reactions ForumReaction[]
  reports   ForumReport[]

  @@index([postId])
  @@index([authorId])
  @@index([parentId])
  @@index([createdAt])
}

model ForumReaction {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId    String?
  post      ForumPost?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  commentId String?
  comment   ForumComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  type      String        @default("UPVOTE")
  createdAt DateTime      @default(now())

  @@unique([userId, postId, type])
  @@unique([userId, commentId, type])
  @@index([postId])
  @@index([commentId])
  @@index([userId])
}

model ForumBookmark {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId    String
  post      ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@unique([userId, postId])
  @@index([userId])
  @@index([postId])
}

model ForumReport {
  id           String            @id @default(cuid())
  reporterId   String
  reporter     User              @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  postId       String?
  post         ForumPost?        @relation(fields: [postId], references: [id], onDelete: Cascade)
  commentId    String?
  comment      ForumComment?     @relation(fields: [commentId], references: [id], onDelete: Cascade)
  reason       ForumReportReason
  description  String?           @db.Text
  status       ForumReportStatus @default(PENDING)
  createdAt    DateTime          @default(now())
  resolvedAt   DateTime?
  resolvedById String?
  resolvedBy   User?             @relation("ReportResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([postId])
  @@index([commentId])
  @@index([reporterId])
}

model ForumUserModeration {
  id           String    @id @default(cuid())
  userId       String    @unique
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  strikes      Int       @default(0)
  isBanned     Boolean   @default(false)
  bannedAt     DateTime?
  banExpiresAt DateTime?
  reason       String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([isBanned])
}

model ForumModerationAudit {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation("ModeratedUser", fields: [userId], references: [id], onDelete: Cascade)
  moderatorId      String?
  moderator        User?    @relation("ModeratorActor", fields: [moderatorId], references: [id], onDelete: SetNull)
  action           String
  reason           String   @db.Text
  severity         String   @default("LOW")
  matchedTerms     Json?
  relatedPostId    String?
  relatedCommentId String?
  createdAt        DateTime @default(now())

  @@index([userId])
  @@index([moderatorId])
  @@index([createdAt])
}

model ForumModerationAppeal {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation("AppealUser", fields: [userId], references: [id], onDelete: Cascade)
  reasonForBan  String
  strikeCount   Int
  bannedAt      DateTime
  banExpiresAt  DateTime?
  appealMessage String    @db.Text
  status        String    @default("OPEN")
  reviewedById  String?
  reviewedBy    User?     @relation("AppealReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewNotes   String?   @db.Text
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId])
  @@index([status])
}

